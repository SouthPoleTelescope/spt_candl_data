for yaml_file in "${yamls[@]}"; do
    # Extract job name from filename (without .yaml extension)
    jobname=$(basename "$yaml_file" .yaml)

    # Resolve the chain output directory from the YAML's `output:` field
    out_prefix=$(grep -E '^[[:space:]]*output[[:space:]]*:' "${dir}/${yaml_file}" | head -n1 \
                 | sed -E 's/^[[:space:]]*output[[:space:]]*:[[:space:]]*//')
    out_prefix=$(eval echo "${out_prefix}")
    chain_dir=$(dirname "${out_prefix}")

    if [[ -n "${out_prefix}" && "${chain_dir}" != "." ]]; then
        mkdir -p "${chain_dir}"
        echo "Submitting: ${jobname}  (${yaml_file})  ->  PBS log in ${chain_dir}/"
        qsub -N "${jobname}" -o "${chain_dir}/" -v YAML_FILE="${yaml_file}" data_spalitetteete_run.pbs
    else
        echo "WARNING: could not resolve output dir for ${yaml_file}; using default PBS log location"
        echo "Submitting: ${jobname}  (${yaml_file})"
        qsub -N "${jobname}" -v YAML_FILE="${yaml_file}" data_spalitetteete_run.pbs
    fi
done
